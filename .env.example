APP_NAME=Travexgo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
SUPABASE_DATABASE_URL=
DB_HOST=YOUR_SUPABASE_POOLER_HOST
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Node/Edge service only; the Laravel application does not consume these.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET_TOUR_PACKAGES=tour-packages
SUPABASE_STORAGE_BUCKET_DESTINATIONS=destinations
SUPABASE_STORAGE_BUCKET_PROFILE_IMAGES=profile-images
SUPABASE_STORAGE_BUCKET_PAYMENT_PROOFS=payment-proofs

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@travexgo.test"
MAIL_FROM_NAME="${APP_NAME}"